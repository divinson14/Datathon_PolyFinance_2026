# Copier ce fichier en .env (jamais commité). AUCUNE clé AWS ici : utilisez `aws configure` ou un rôle IAM.

# local = agents simulés, aucun appel AWS (pour développer sans compte)
# bedrock = vrais appels à Amazon Bedrock
MODE=bedrock

AWS_REGION=us-east-1
# Petit modèle rapide pour l'Agent Profil, modèle plus capable pour l'Explicabilité.
# Copiez les identifiants exacts depuis la console Bedrock (Model access).
BEDROCK_MODELE_RAPIDE=us.anthropic.claude-haiku-5-5
BEDROCK_MODELE_REDACTION=us.anthropic.claude-sonnet-5-5
# Facultatif : seulement pour un modèle qui accepte encore `temperature` (les Claude récents le refusent).
BEDROCK_TEMPERATURE=
# Bedrock Guardrails (MODE=bedrock) : contrôle la DEMANDE et la RÉPONSE affichée (src/verif/guardrails.py).
# Identifiant et version copiés depuis la console Bedrock > Guardrails. Vide = garde-fou local seulement.
# Version vide = DRAFT.
BEDROCK_GUARDRAIL_ID=7xq7ledpn2cm
BEDROCK_GUARDRAIL_VERSION=2
# Agent Analyste : strands = agent Strands qui choisit ses outils (si MODE=bedrock) ; fixe = plan fixe.
ANALYSTE=strands
# Modèle de l'Analyste (tool use). Vide = BEDROCK_MODELE_REDACTION.
BEDROCK_MODELE_ANALYSTE=
# URL de fonction Lambda pour les outils de calcul (requêtes signées avec les identifiants AWS).
LAMBDA_OUTILS_URL=https://clpgufrebwhh743mjweiwgj4iy0zfqsa.lambda-url.us-east-1.on.aws/
# Clé API Bedrock (alternative à `aws configure`) : à renseigner UNIQUEMENT dans .env, jamais ici ni dans git.
#AWS_BEARER_TOKEN_BEDROCK=

# Données : local = ../data/processed ; s3 = bucket ci-dessous ; demo = données fictives intégrées
DONNEES=s3
S3_BUCKET=alphaforge-donnees-at2026
S3_PREFIX=processed/

# Traces : local = fichiers JSONL dans traces_locales/ ; dynamodb = table ci-dessous
TRACES=dynamodb
DYNAMODB_TABLE=alphaforge-traces
